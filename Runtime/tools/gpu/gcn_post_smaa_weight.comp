#version 450
// SMAA 1x, pass 2: blending weights (in0: the edges, in1: AreaTex, in2: SearchTex).
#include "gcn_post.glsl"
#define SMAA_RT_METRICS pc.rt
#define SMAA_GLSL_4 1
#define SMAA_PRESET_HIGH 1
#include "SMAA.glsl"

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) return;
    vec2 tc = (vec2(p) + 0.5) * pc.rt.xy;
    vec2 pix;
    vec4 off[3];
    SMAABlendingWeightCalculationVS(tc, pix, off);
    vec4 w = SMAABlendingWeightCalculationPS(tc, pix, off, in0, in1, in2, vec4(0.0));
    imageStore(outImg, p, w);
}

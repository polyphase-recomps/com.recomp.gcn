# --- Game code and data: never commit ----------------------------------------------------
# The game packages' build scripts translate each game into Source/Guest/<name>. That C is
# the compiled game, with data taken from YOUR OWN disc: build it locally, never publish it.
Source/Guest/
# Disc images, wherever they end up.
*.iso
*.gcm
*.rvz
*.ciso
*.gcz
*.wbfs

# --- Build output ------------------------------------------------------------------------
build/
Runtime/build/

# --- Tooling -----------------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
*.vcxproj.user
# Machine-specific include paths, regenerated by the editor
# (Tools > Addons > Regenerate Native Addon Dependencies).
.vscode/

# --- Recomp mode: the recompiled game libraries (your disc's code; never commit) --------------
/Lib/
